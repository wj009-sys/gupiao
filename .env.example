# ============ 股票投研自动化 — 环境变量模板 ============
# 复制本文件为 .claude/settings.local.json，填入真实值
# （.claude/settings.local.json 已被 .gitignore 排除，不会提交）

# ----- 数据源 -----
TUSHARE_TOKEN=xxx                        # Tushare Pro API Token

# ----- 通知：Telegram -----
TELEGRAM_BOT_TOKEN=""                    # BotFather 创建的 Bot Token
TELEGRAM_CHAT_ID=""                      # 接收消息的 Chat ID（@userinfobot 获取）

# ----- 通知：企业微信 -----
# 方式一：7个独立机器人（每个Agent各一个，推荐）
WECHAT_WEBHOOK_1=""                      # 🤖 1号：情报员 机器人 Webhook URL
WECHAT_WEBHOOK_2=""                      # 🤖 2号：分析师 机器人 Webhook URL
WECHAT_WEBHOOK_3=""                      # 🤖 3号：风控官 机器人 Webhook URL
WECHAT_WEBHOOK_4=""                      # 🤖 4号：复盘师 机器人 Webhook URL
WECHAT_WEBHOOK_5=""                      # 🤖 5号：选股机器人  Webhook URL
WECHAT_WEBHOOK_6=""                      # 🤖 6号：操盘手 机器人 Webhook URL
WECHAT_WEBHOOK_7=""                      # 🤖 7号：投资领导 机器人 Webhook URL
# 方式二：通用机器人（所有Agent共用，不推荐）
WECHAT_WEBHOOK_URL=""                    # 通用机器人 Webhook URL

# ----- 通知：QQ（PushPlus）-----
PUSHPLUS_TOKEN=""                        # PushPlus Token（pushplus.plus 获取）

# ----- 通知：QQ邮箱 SMTP（备用）-----
QQ_MAIL_USER=""                          # QQ邮箱地址（xxx@qq.com）
QQ_MAIL_PASS=""                          # QQ邮箱 SMTP 授权码
QQ_MAIL_TO=""                            # 目标邮箱（默认同 QQ_MAIL_USER）

# ----- 通知：QQ机器人（官方API）-----
QQBOT_APP_ID=""                          # QQ机器人 AppID（q.qq.com 创建）
QQBOT_APP_SECRET=""                      # QQ机器人 AppSecret
QQBOT_TARGET_OPENID=""                   # 目标用户 OpenID（qqbot_listen 获取）
QQBOT_TARGET_GROUP=""                    # 目标群 GroupOpenID（与上面二选一）
