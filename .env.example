# ============ 股票投研自动化 — 环境变量模板 ============
# 说明: 本文件是 Claude Code settings.local.json 的环境变量模板。
# 使用方式: 将这些键值对填入 .claude/settings.local.json 的 env 字段
# （.claude/settings.local.json 已被 .gitignore 排除，不会提交）
#
# 示例 settings.local.json 结构:
# {
#   "env": {
#     "TUSHARE_TOKEN": "your_token_here",
#     "PATH": "original_path;...;python_dir",
#     ...
#   }
# }

# ----- 必要配置 -----
TUSHARE_TOKEN=xxx                        # Tushare Pro API Token（必需，被 scripts/utils/tushare_client.py 读取）
PUSHPLUS_TOKEN=xxx                       # PushPlus Token（主微信推送通道，被 wechat_send.py / QQ MCP 读取）

# ----- 网络代理（选填） -----
SOCKS_PROXY=                             # Tushare API 代理地址，如 socks5://127.0.0.1:1080（如需翻墙访问）

# ----- 系统路径（选填） -----
# 注意：使用 venv/Scripts/python.exe 运行脚本，通常无需额外设置 PATH
PATH=                                     # 如 C:\Python314;C:\Python314\Scripts
PYTHON_PATH=                              # Python安装目录，如 C:\Users\xxx\AppData\Local\Programs\Python\Python314
