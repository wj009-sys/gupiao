# ============ 股票投研自动化 — 环境变量模板 ============
# 复制本文件为 .claude/settings.local.json，填入真实值
# （.claude/settings.local.json 已被 .gitignore 排除，不会提交）

# ----- 数据源 -----
TUSHARE_TOKEN=xxx                        # Tushare Pro API Token（必需）

# ----- Python 路径（选填，自动检测） -----
PYTHON_PATH=""                           # Python 安装路径，如 C:\Python314

# ----- 代理（选填，用于 Telegram 等需代理的服务） -----
SOCKS_PROXY=""                           # 如 socks5://127.0.0.1:10808
