cc-connect.toml
.cc-connect.toml.lock

# LLM配置（含API Key）
data/llm_config.json

# 微信扫码二维码（临时生成，不需存档）
wechat_qr_*.png
data/checkpoints/

# 定时任务锁文件（自动生成）
.claude/scheduled_tasks.lock

# 工作树隔离目录（自动生成）
.claude/worktrees/

# Agent 团队收件箱 + 任务输出（运行时生成）
.claude/teams/
.claude/task_outputs/

# 交易日历缓存（自动生成，如不再需版本控制：git rm --cached data/trading_calendar.json）
# data/trading_calendar.json 目前仍被 git 跟踪，完全忽略前需 git rm --cached

